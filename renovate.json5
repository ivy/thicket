// Renovate configuration for thicket, run by the Mend Renovate app installed on
// the steading-ai organization.
// Full reference: https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Shared defaults. This file holds only what is true of thicket.
  "extends": ["github>ivy/renovate-config"],

  // custom.regex is the shared preset's manager for the gh-actions-lock pin in
  // .github/workflows/actions-lock.yml; github-actions also regenerates
  // .github/workflows/actions.lock.
  "enabledManagers": ["npm", "gomod", "mise", "github-actions", "custom.regex"],

  // pnpm-lock.yaml is lockfileVersion 9.0, which Renovate maps to "pnpm >=9" —
  // that would regenerate the lockfile with whatever pnpm is newest, not the
  // one mise.toml pins and CI installs with --frozen-lockfile. The floor has to
  // honour minimumReleaseAge in pnpm-workspace.yaml (10.16 and later), the
  // week-long floor this whole file is built around, and 11.28.8 is the first
  // release whose standalone build embeds a Node.js that distrusts the
  // compromised eMudhra intermediates (CVE-2026-111943). A pnpm major is never
  // automerged, so whoever lands one moves this too.
  "constraints": {
    "pnpm": "^11.28.8"
  },

  // Regenerating the lockfile is the only way a vulnerable *transitive*
  // dependency moves, since Renovate's vulnerability PRs touch direct ones.
  // pnpm still refuses anything younger than a week while it resolves.
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"]
  },

  "postUpdateOptions": ["gomodTidy"],

  "packageRules": [
    // The constraint above has to move with a pnpm major, so a person does both.
    {
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },

    // -------------------------------------------------------------------------
    // Batching: one PR per ecosystem, not one per dependency.
    //
    // Majors stay out of the groups so a single breaking bump can't hold a
    // batch of safe ones hostage.
    // -------------------------------------------------------------------------
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev dependencies"
    }
  ]
}
