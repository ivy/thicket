amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

// hk merges this file with the operator's global config rather than replacing it:
// with a project hk.pkl present, a pre-commit run executes these steps *and* the
// global gitleaks step. Verified against hk 1.50.0.

local workflows = new Mapping<String, Step> {
    // Reads .github/jactionlint.yaml and .github/workflows/actions.lock, so a
    // tag ref the lockfile pins passes the unpinned-uses rule.
    ["jactionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "jactionlint --format gcc {{files}}"
        fix = "jactionlint --fix {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        steps = workflows
    }
    ["check"] {
        steps = workflows
    }
}
