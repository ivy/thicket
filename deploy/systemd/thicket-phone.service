# thicket phone — Twilio ConversationRelay <-> A2A. Runs in its own account on
# the always-on host, behind its own thicket-netd.service, whose Funnel
# listener is the only way in: the bridge binds a unix socket, never a port.
[Unit]
Description=thicket phone (ConversationRelay to A2A)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/thicket-phone
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=120
# A restart drops every live call; SIGTERM lets the wrap-ups land first.
TimeoutStopSec=20

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
StateDirectory=thicket
RuntimeDirectory=thicket
RuntimeDirectoryPreserve=yes
ReadWritePaths=%S/thicket
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
