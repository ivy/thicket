# thicket agentd — the A2A daemon. Starts with the session and stays
# resident: the hot Claude Code session pool is the point of staying alive.
#
# agentd creates its own 0600 socket inside %t/thicket, the way it already
# does under launchd. It cannot be socket-activated: Bun will not listen on
# a descriptor it did not open, and agentd refuses that path rather than
# coming up mute. See docs/tasks/archived/047-socket-activation-after-bun.md.
[Unit]
Description=thicket agentd (A2A server)

[Service]
ExecStart=%h/.local/bin/thicket-agentd
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=120
# And a limit it can actually reach. The defaults cannot: a ten-second window
# against a five-second delay fits two attempts, so a unit that will never
# start reports `active` forever and nothing downstream can see it — `failed`
# is the state every alert, dashboard and glance is watching for. With the
# backoff above capped at 120s, ten attempts take at most twenty minutes and
# thirty is comfortably past them.
StartLimitIntervalSec=1800
StartLimitBurst=10
# Let SIGTERM drain in-flight turns before systemd escalates.
TimeoutStopSec=45
KillMode=mixed

# The agent's job is to work inside its own home; system directories stay
# read-only. Claude Code sessions inherit only what agentd passes.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
StateDirectory=thicket
RuntimeDirectory=thicket
# Nothing but this account has any business in the socket directory; the
# socket itself is 0600 as well, which is what agentd's trust in the
# peer-tags header rests on.
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
