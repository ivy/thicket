# The phone bridge. Twilio reaches it from the public internet through its
# netd's Funnel listener, and it reaches nothing back except through the same
# netd: no network namespace of its own, no route, no resolver.
#
# systemd-analyze security: 0.8 SAFE.
[Unit]
Description=thicket phone bridge
# netd owns the runtime directory the two of them meet in, and there is
# nothing for the bridge to say until it exists. Wants, not Requires: netd
# restarting must not take the bridge with it.
After=thicket-phone-netd.service
Wants=thicket-phone-netd.service

[Service]
Type=simple
User=thicket-phone
Group=thicket-phone
# Its own group is the group the pair meet in: netd carries it as a
# supplementary and nothing else on the host is a member. A group shared with
# another pair would hand each of them the other's egress allowlist.
ExecStart=/usr/local/bin/thicket-phone
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=120
# Let SIGTERM drain an in-flight turn before systemd escalates.
TimeoutStopSec=45
KillMode=mixed

ConfigurationDirectory=thicket
# Its own subdirectory, not the whole of /var/lib/thicket: the Slack bridge
# keeps its state in the sibling one, and two units that each declare the
# parent fight over who owns it.
StateDirectory=thicket/phone
# netd creates and owns /run/thicket-phone; the bridge is ordered after it and
# writes its own socket there as a member of the group. Its own directory,
# because the socket names under it are the same as the Slack bridge pair's.
ReadWritePaths=/run/thicket-phone
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_STATE_HOME=/var/lib
Environment=XDG_RUNTIME_DIR=/run

# The Twilio credentials, the operator's numbers and the PIN, handed over by
# systemd rather than left where the account could read them. The file on disk
# is root's alone; the process sees a copy that exists only while it runs.
LoadCredential=phone.json:/etc/thicket/phone.json
Environment=THICKET_PHONE_CONFIG=%d/phone.json

# The containment. No network namespace at all — no interface, no route, no
# resolver — so netd's socket is not the preferred way out, it is the only
# one. Honest only because every leg is routed: A2A, the Slack Web API, and
# the Socket Mode websocket, which the bridge speaks itself for this reason.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Not PrivateUsers: it maps away every uid but this service's own, and the
# bridge has to hand its socket to the group netd reaches it through. What
# contains this unit is having no network, not that.
#
# Never MemoryDenyWriteExecute: Bun compiles as it runs, and the process dies
# on its first turn without a writable-executable mapping.
#
# PrivateTmp is off deliberately. The two units meet on a socket under /run,
# and a private namespace is one step away from a rendezvous that silently
# does not happen — each unit would get its own /tmp, and anything that fell
# back to it would find an empty directory rather than an error.
PrivateTmp=no

[Install]
WantedBy=multi-user.target
