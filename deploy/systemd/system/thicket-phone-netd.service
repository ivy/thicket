# The phone bridge's netd. This is the one process in the fleet the public
# internet reaches: a Tailscale Funnel listener on 443 in front of the phone
# bridge's socket, with netd's own budget spent before a request gets there.
# It is also the phone bridge's only way out.
#
# Its own account, deliberately. netd is the one process in this pair that
# may speak to the network, and a firewall rule can only say so if the two
# are different uids — see "One account, or two" in ../../README.md.
#
# systemd-analyze security: 4.1 OK. It has the network, which is the point.
[Unit]
Description=thicket netd for the phone bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thicket-phone-netd
# The bridge's own group, carried here as the primary one so the runtime
# directory systemd creates below is owned by it: that directory is where the
# bridge creates its socket. The pair and nothing else are members — a group
# shared with the Slack bridge pair would let either open the other's egress
# socket, and with it the other's allowlist.
Group=thicket-phone
# And netd's own group back, because its credential is readable by that and
# not by the shared one. The bridge has no business reading netd's tailnet
# identity.
SupplementaryGroups=thicket-phone-netd
# Named outright: both edge pairs keep their config in one /etc/thicket,
# so neither netd can be the one that takes the default name.
ExecStart=/usr/local/bin/thicket-netd --config /etc/thicket/phone-netd.json
# netd.json may name its auth key file relative to the config directory, and
# netd resolves that against the working directory.
WorkingDirectory=/etc/thicket
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=120
# And a limit it can actually reach. The defaults cannot: a ten-second window
# against a five-second delay fits two attempts, so a unit that will never
# start reports `active` forever and nothing downstream can see it — `failed`
# is the state every alert, dashboard and glance is watching for. With the
# backoff above capped at 120s, ten attempts take at most twenty minutes and
# thirty is comfortably past them.
StartLimitIntervalSec=1800
StartLimitBurst=10

# The XDG variables both binaries read, pinned at the directories systemd
# creates and owns: /etc for what the operator writes, /var/lib for what the
# process keeps, /run for the sockets the pair meet on.
ConfigurationDirectory=thicket
# Its own state. The bridge owns /var/lib/thicket and they are not the same
# user; netd.json points tsnet at this one with "state_dir".
StateDirectory=thicket-phone-netd
# tsnet's state includes this node's key. Nobody but netd, group included.
StateDirectoryMode=0700
# Its own, not /run/thicket: the socket names under it are the same as the
# Slack bridge pair's, so two pairs sharing one directory would collide on
# them. netd.json and phone.json name the paths under this one.
RuntimeDirectory=thicket-phone
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0770
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_STATE_HOME=/var/lib
Environment=XDG_RUNTIME_DIR=/run

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
