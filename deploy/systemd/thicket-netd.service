# thicket netd — holds this account's tailnet identity and proxies to agentd.
# Same file for every agent account: the unix user is the instance, so paths
# use specifiers (%h home, %S state root, %t runtime root), never literals.
[Unit]
# A restart loop has to be able to end, and these are [Unit] directives: in
# [Service] the interval is silently ignored, because only the old
# StartLimitBurst survives there for compatibility. That looks like it worked
# and does not.
#
# systemd's defaults cannot be reached by anything that waits between
# attempts — a ten-second window against a five-second delay fits two — so a
# unit that will never start reports `active` forever, and `failed` is the
# state every alert, dashboard and glance is watching for. With the backoff
# below capped at 120s, ten attempts take at most twenty minutes; thirty is
# comfortably past them.
StartLimitIntervalSec=1800
StartLimitBurst=10
Description=thicket netd (tailnet transport shim)
# No ordering against agentd: netd dials its socket per request, so a
# request that arrives before agentd is up gets a 502 and the next one
# succeeds. Nothing here has to wait for anything there.
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/thicket-netd
Restart=on-failure
RestartSec=5
# systemd >= 254 backs off progressively; older versions ignore these two.
RestartSteps=5
RestartMaxDelaySec=120

# Hardening. netd needs its tsnet state dir and the runtime dir for the
# egress socket; everything else system-side stays read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
StateDirectory=thicket
RuntimeDirectory=thicket
RuntimeDirectoryPreserve=yes
ReadWritePaths=%S/thicket

# Auth key delivery: TS_AUTHKEY wins over auth_key_file if set here.
# Environment=TS_AUTHKEY=tskey-...   <- never commit a real key

[Install]
WantedBy=default.target
