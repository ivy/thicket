{
  "name": "thicket",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "bun --bun tsc -b",
    "test": "bun test",
    "lint": "pnpm lint:js && pnpm lint:workflows",
    "lint:js": "bun --bun eslint .",
