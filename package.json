    "compile": "bun run scripts/compile.ts",
    "package": "bun run scripts/package.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
